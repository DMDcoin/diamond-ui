{
  "name": "diamond-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "contracts:update-dao": "find ../diamond-contracts-dao/artifacts/contracts -type f -name '*.json' ! -name '*.dbg.json' -exec cp {} ./src/contracts/abis \\;",
    "contracts:update-core": "find ../diamond-contracts-core/artifacts/contracts -type f -name '*.json' ! -name '*.dbg.json' -exec cp {} ./src/contracts/abis \\;",
    "contracts:update-registry": "find ../diamond-contracts-registry/abi -type f -name '*.json' ! -empty -exec cp {} ./src/contracts/abis \\;",
    "contracts:update-all": "npm run contracts:update-dao && npm run contracts:update-core && npm run contracts:update-registry",
    "contracts:typechain": "typechain --target web3-v1 --out-dir src/contracts/types 'src/contracts/abis/**/*.json'",
    "contracts:build": "npm run contracts:update-all && npm run contracts:typechain",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --force-recreate",
    "docker:up:build": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:reload": "docker compose up -d --force-recreate",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up --build",
    "docker:logs": "docker compose logs -f",
    "docker:config": "curl -s http://localhost:3000/api/config | json_pp || curl -s http://localhost:3000/api/config"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@reown/appkit": "^1.7.10",
    "@reown/appkit-adapter-wagmi": "^1.7.10",
    "@tanstack/react-query": "^5.81.2",
    "@typechain/web3-v1": "^6.0.7",
    "@walletconnect/web3-provider": "^1.8.0",
    "axios": "^1.10.0",
    "bignumber.js": "^9.3.0",
    "copy-to-clipboard": "^3.3.3",
    "ethereumjs-util": "^7.1.5",
    "ioredis": "^5.10.1",
    "next": "15.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-jazzicon": "^1.0.4",
    "react-toastify": "^11.0.5",
    "recharts": "^3.7.0",
    "typechain": "^8.3.2",
    "viem": "^2.31.4",
    "wagmi": "^2.15.6",
    "web3": "^1.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "typescript": "^5"
  }
}
